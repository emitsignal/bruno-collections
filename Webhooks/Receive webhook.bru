meta {
    name: Receive webhook
    seq: 9
    type: http
}

post {
    auth: none
    body: json
    url: {{baseUrl}}/h/{{webhookSlug}}
}

headers {
    Content-Type: application/json
}

body:json {
  {
      "environment": "production",
      "event": "deployment.succeeded",
      "sha": "0354654"
  }
}

docs {
  The public ingest endpoint providers POST to — never authenticated with the
  collection token. If the webhook has a verification scheme, the matching
  signature header must be present and must validate against this exact body.
}
