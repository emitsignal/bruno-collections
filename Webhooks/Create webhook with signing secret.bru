meta {
  name: Create webhook with signing secret
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/webhooks
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "stripe events",
    "source": "stripe",
    "topicName": "{{topic}}",
    "verification": "stripe",
    "secret": "replace-with-the-provider-signing-secret"
  }
}

docs {
  The secret is encrypted at rest and never returned; responses only expose
  `hasSecret`. An update may change the scheme without re-sending the secret.
}
