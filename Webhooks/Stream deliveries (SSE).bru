meta {
    name: Stream deliveries (SSE)
    seq: 8
    type: http
}

get {
    auth: inherit
    body: none
    url: {{baseUrl}}/webhooks/stream
}

headers {
    Accept: text/event-stream
}

params:query {
    ~source: github
}

docs {
  Live feed of incoming deliveries across the user's webhooks; `source` filters
  to one provider. Long-lived — cancel the request when done.
}
