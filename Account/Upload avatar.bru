meta {
  name: Upload avatar
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/user/avatar
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file()
}

docs {
  Field name is `file`. Only image/jpeg, image/png, and image/webp are accepted —
  SVG is rejected because it would execute script when served inline.
}
