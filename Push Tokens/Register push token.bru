meta {
    name: Register push token
    seq: 2
    type: http
}

post {
    auth: inherit
    body: json
    url: {{baseUrl}}/push-tokens
}

headers {
    Content-Type: application/json
}

body:json {
  {
      "deviceId": "{{deviceId}}",
      "platform": "ios",
      "token": "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]"
  }
}

docs {
  `platform` is `ios`, `android`, or `web`.
}
