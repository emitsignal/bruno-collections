meta {
  name: List subscriptions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/subscriptions?deviceId={{deviceId}}
  body: none
  auth: inherit
}

params:query {
  ~deviceId: {{deviceId}}
}

docs {
  Pass `deviceId` to read an anonymous device's subscriptions; authenticated
  users can omit it to read their own.
}
