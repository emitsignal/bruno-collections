meta {
    name: Update subscription
    seq: 3
    type: http
}

patch {
    auth: inherit
    body: json
    url: {{baseUrl}}/subscriptions/{{subscriptionId}}
}

headers {
    Content-Type: application/json
}

body:json {
  {
      "deviceId": "{{deviceId}}",
      "pushEnabled": false,
      "settings": {
          "description": "muted for now",
          "listenSince": "always"
      }
  }
}
