meta {
  name: List subscribed messages
  seq: 6
  type: http
}

get {
  auth: inherit
  body: none
  url: {{baseUrl}}/subscriptions/messages?deviceId={{deviceId}}&limit=50
}

params:query {
  ~cursor:
  deviceId: {{deviceId}}
  limit: 50
  ~minPriority: 3
  ~tags: deploy
  ~topicName: {{topic}}
}

docs {
  The unified inbox across every subscribed topic. `limit` is 1-200.
}
