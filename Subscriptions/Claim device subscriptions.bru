meta {
  name: Claim device subscriptions
  seq: 5
  type: http
}

post {
  auth: inherit
  body: json
  url: {{baseUrl}}/subscriptions/claim
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "deviceId": "{{deviceId}}"
  }
}

docs {
  Attaches subscriptions that a device created anonymously to the now
  authenticated user.
}
