meta {
    name: Publish with actions and media
    seq: 5
    type: http
}

post {
    auth: inherit
    body: json
    url: {{baseUrl}}/publish/{{topic}}
}

headers {
    Content-Type: application/json
}

body:json {
  {
      "actions": [
          {
              "label": "Open run",
              "type": "view",
              "url": "https://example.com/runs/42"
          },
          {
              "label": "Ack",
              "type": "acknowledge"
          }
      ],
      "bannerImage": {
          "href": "https://example.com/banner.png",
          "title": "run summary"
      },
      "body": "3 tests failed on main",
      "inlineAttachments": [
          {
              "href": "https://example.com/build.log",
              "title": "build.log"
          }
      ],
      "inlineImages": [
          "https://example.com/chart.png"
      ],
      "priority": 4,
      "title": "Build failed"
  }
}

docs {
  At most 2 actions. `type` is `view` (needs `url`) or `acknowledge`. Media
  entries are a URL string or `{ href, title }`; the per-array inline limit
  depends on the publisher's plan (anonymous publishers get the smallest).
}
