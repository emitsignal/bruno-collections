meta {
    name: Publish scheduled
    seq: 4
    type: http
}

post {
    auth: inherit
    body: json
    url: {{baseUrl}}/publish/{{topic}}
}

headers {
    Content-Type: application/json
}

body:json {
  {
      "body": "fires in five minutes",
      "scheduledAt": {{scheduledAt}},
      "title": "Scheduled reminder"
  }
}

script:pre-request {
  bru.setVar("scheduledAt", Math.floor(Date.now() / 1000) + 300);
}

docs {
  `scheduledAt` is a unix timestamp in seconds, at most one year out. Scheduled
  messages skip the SSE bus and go straight onto the schedule queue, so the
  response is `{ "message": "scheduled" }` rather than `"posted"`.
}
