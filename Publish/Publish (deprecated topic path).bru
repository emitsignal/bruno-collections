meta {
  name: Publish (deprecated topic path)
  seq: 6
  type: http
}

post {
  auth: inherit
  body: json
  url: {{baseUrl}}/topic/{{topic}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "body": "responds with Deprecation and Link headers",
    "title": "Legacy path"
  }
}

docs {
  Identical behaviour to `POST /publish/*`, kept for older clients. The response
  carries `Deprecation` and `Link: </publish/*>; rel="successor-version"`.
}
