meta {
    name: Publish JSON
    seq: 1
    type: http
}

post {
    auth: inherit
    body: json
    url: {{baseUrl}}/publish/{{topic}}
}

headers {
    Content-Type: application/json
}

body:json {
  {
      "body": "api@1.4.2 is live in production",
      "priority": 3,
      "tags": [
          "deploy",
          "production"
      ],
      "title": "Deploy finished"
  }
}

script:post-response {
  if (res.getBody()?.messageId) {
      bru.setEnvVar("messageId", res.getBody().messageId);
  }
}

docs {
  `priority` is 1-5 (3 = default). At least one of `title` or `body` must be
  non-empty. Publishing works anonymously too — anonymous callers are throttled
  per IP, authenticated ones additionally consume their plan's daily quota.
}
