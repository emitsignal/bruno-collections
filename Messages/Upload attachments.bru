meta {
  name: Upload attachments
  seq: 3
  type: http
}

post {
  auth: inherit
  body: multipartForm
  url: {{baseUrl}}/messages/{{messageId}}/attachments
}

body:multipart-form {
  files: @file()
}

docs {
  Multipart upload under the field name `files` (repeat it for several files).
  Point the file picker at something local before sending.
}
