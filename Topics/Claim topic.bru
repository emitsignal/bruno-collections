meta {
  name: Claim topic
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/topics/{{topic}}/claim
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accessMode": "private"
  }
}

docs {
  Takes ownership of an unclaimed topic. Returns 409 `already_claimed` if it
  already has an owner.
}
