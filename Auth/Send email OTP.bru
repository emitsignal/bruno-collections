meta {
  name: Send email OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/email-otp/send-verification-otp
  body: json
  auth: none
}

body:json {
  {
    "email": "you@example.com",
    "type": "sign-in"
  }
}

docs {
  With EMAIL_PROVIDER=log (the dev default) the magic link and OTP are printed to
  the server console instead of being sent.
}
